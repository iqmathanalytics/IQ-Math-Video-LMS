SECRET_KEY="change_me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public site used in password-reset emails, and added to CORS.
# Local: http://localhost:5173
# Production: the Cloudflare Pages URL, no trailing path
FRONTEND_URL="http://localhost:5173"
# Extra browser origins that may call this API, comma-separated, no trailing slash.
# Production example:
# ALLOWED_ORIGINS="https://iqmath.pages.dev,https://www.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# DB can be PostgreSQL or TiDB/MySQL
# PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/iqmath"
# TiDB/MySQL:
# DATABASE_URL="mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?ssl_verify_cert=true&ssl_verify_identity=true"
DATABASE_URL="mysql://user:password@host:4000/test?ssl_verify_cert=true&ssl_verify_identity=true"

RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
GEMINI_API_KEY="your_gemini_api_key"
EMAIL_SENDER="your_email@example.com"
BREVO_API_KEY="your_brevo_api_key"
# Code execution (Java/C++/batch tests) — Function URL, no trailing slash required
AWS_LAMBDA_URL="https://bgrigjy3huq2mqyw7rdqsqc4ne0tktgf.lambda-url.us-east-2.on.aws/"
